    "Table of Random Objectives": {
      "name": "Table of Random Objectives",
      "description": "<p>Layering Goals Other than Attrition into Combat</p>",
      "results": {
        "1-1": "<p>Acquire (obtain or steal) an important item or items.</p>",
        "2-2": "<p>Capture one or more of the opponents.</p>",
        "3-3": "<p>Activate a magical device.</p>",
        "4-4": "<p>Frame a character or tarnish their reputation.</p>",
        "5-5": "<p>Drive the opponent into a corner or ambush point.</p>",
        "6-6": "<p>Stop a magical ritual, legal ceremony, or time-sensitive spell.</p>",
        "7-7": "<p>Hold the line—keep the enemy from reaching a specific area or group.</p>",
        "8-8": "<p>Plant evidence or a tracking device on a target.</p>",
        "9-9": "<p>Secure a specific location ahead of another group’s arrival.</p>",
        "10-10": "<p>Harass the opponent to deplete their resources or keep them occupied.</p>",
        "11-11": "<p>Destroy a piece of architecture, a statue, a shrine, or a weapon.</p>",
        "12-12": "<p>Investigate a situation to confirm or deny existing information.</p>"
      }
    },
